{
  "name": "registre-securite",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "android": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:build": "npm run build && npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && node -e \"const fs=require('fs'),p=require('path'),v=require('./package.json').version;fs.mkdirSync('./build-apk',{recursive:true});const src='./android/app/build/outputs/apk/debug/app-debug.apk',dst='./build-apk/Registre_Securite_v'+v+'.apk';fs.copyFileSync(src,dst);console.log('APK v'+v+' -> '+dst);\"",
    "test": "node --test",
    "check:electron": "node --check electron-main.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "canvas": "^3.2.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "ico-endec": "^0.1.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  }
}
